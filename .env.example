# Réglages privés de CandiPilot : copie ce fichier en .env (jamais publié sur GitHub) et remplis-le.
# start.sh et deploy.sh le chargent automatiquement.

# Envoi des e-mails « mot de passe oublié ».
# Recommandé : clé API Brevo (brevo.com > SMTP et API > Clés API), et l'expéditeur dans CANDIPILOT_SMTP_FROM.
CANDIPILOT_BREVO_API_KEY=
# Ou par SMTP, exemple avec Gmail :
#   1. Active la validation en deux étapes sur ton compte Google.
#   2. Crée un « mot de passe d'application » : https://myaccount.google.com/apppasswords
#   3. Colle-le ci-dessous (16 lettres, sans espaces).
CANDIPILOT_SMTP_HOST=smtp.gmail.com
CANDIPILOT_SMTP_PORT=587
CANDIPILOT_SMTP_USER=ton.adresse@gmail.com
CANDIPILOT_SMTP_PASSWORD=
CANDIPILOT_SMTP_FROM=CandiPilot <ton.adresse@gmail.com>
